--- /dev/null
+++ b/crates/fm1-live/src/panel_midi.rs
@@ -0,0 +1,85 @@
+//! MIDI control of the FM-1's front panel (`--panel-ch N`, default 16).
+//!
+//! Control changes on the panel channel turn the knobs and press the buttons, as the mouse
+//! does, instead of going to the firmware's MIDI IN. Every other message, and every message
+//! on other channels, plays the firmware as before.
+//!
+//! | CC        | Control                                                          |
+//! |-----------|------------------------------------------------------------------|
+//! | 20        | MASTER pot, relative                                             |
+//! | 21..=27   | SELECT, PRESETS, ALGORITHM, KNOB1..KNOB4, relative               |
+//! | 102..=115 | buttons OCT- OCT+ FX SCL ENV LFO EDIT GLO HOME SAVE ARP SEQ PLAY REC |
+//!
+//! Relative values: 64 + n turns n clicks clockwise, 64 - n turns n clicks anticlockwise
+//! (a Novation ReMOTE SL encoder in REL1 mode sends 65 / 63, in REL2 64 ± n).
+//! Buttons: a value of 64 or more presses, below 64 releases.
+
+/// CC number of the MASTER pot.
+pub const CC_MASTER: u8 = 20;
+/// First encoder CC; the encoders follow in `panel::ENCS` order.
+pub const CC_ENC0: u8 = 21;
+/// First button CC; button matrix ids 0..=13 follow.
+pub const CC_BTN0: u8 = 102;
+/// Pot steps (of 0..=1023) per MASTER click: 64 clicks sweep the whole range.
+pub const POT_STEP: i32 = 16;
+
+/// One panel action decoded from a control change.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum PanelMsg {
+    /// Turn the MASTER pot by this many clicks.
+    Master(i32),
+    /// Turn an encoder (index into `panel::ENCS`) by this many clicks.
+    Enc(usize, i32),
+    /// Press (true) or release (false) a button (matrix id 0..=13).
+    Btn(u8, bool),
+}
+
+/// The panel action for a MIDI message, if it is a mapped control change on `panel_ch`
+/// (1..=16; 0 turns panel control off).
+pub fn decode(msg: &[u8], panel_ch: u8) -> Option<PanelMsg> {
+    if panel_ch == 0 || msg.len() < 3 || msg[0] != 0xb0 | (panel_ch - 1) {
+        return None;
+    }
+    let (cc, v) = (msg[1], msg[2] as i32);
+    let rel = v - 64;
+    match cc {
+        CC_MASTER => Some(PanelMsg::Master(rel)),
+        c if (CC_ENC0..CC_ENC0 + 7).contains(&c) => Some(PanelMsg::Enc((c - CC_ENC0) as usize, rel)),
+        c if (CC_BTN0..CC_BTN0 + 14).contains(&c) => Some(PanelMsg::Btn(c - CC_BTN0, v >= 64)),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rel1_encoders_turn_one_click() {
+        assert_eq!(decode(&[0xbf, 21, 65], 16), Some(PanelMsg::Enc(0, 1)));
+        assert_eq!(decode(&[0xbf, 27, 63], 16), Some(PanelMsg::Enc(6, -1)));
+        assert_eq!(decode(&[0xbf, 20, 65], 16), Some(PanelMsg::Master(1)));
+    }
+
+    #[test]
+    fn rel2_encoders_turn_several_clicks() {
+        assert_eq!(decode(&[0xbf, 22, 67], 16), Some(PanelMsg::Enc(1, 3)));
+        assert_eq!(decode(&[0xbf, 22, 60], 16), Some(PanelMsg::Enc(1, -4)));
+    }
+
+    #[test]
+    fn buttons_press_and_release() {
+        assert_eq!(decode(&[0xbf, 102, 127], 16), Some(PanelMsg::Btn(0, true)));
+        assert_eq!(decode(&[0xbf, 115, 0], 16), Some(PanelMsg::Btn(13, false)));
+    }
+
+    #[test]
+    fn other_messages_go_to_the_firmware() {
+        assert_eq!(decode(&[0xb0, 21, 65], 16), None);     // another channel
+        assert_eq!(decode(&[0x9f, 60, 100], 16), None);    // a note on the panel channel
+        assert_eq!(decode(&[0xbf, 1, 64], 16), None);      // an unmapped CC
+        assert_eq!(decode(&[0xbf, 116, 127], 16), None);   // past the last button
+        assert_eq!(decode(&[0xbf, 21, 65], 0), None);      // panel control off
+        assert_eq!(decode(&[0xb3, 21, 65], 4), Some(PanelMsg::Enc(0, 1)));
+    }
+}
